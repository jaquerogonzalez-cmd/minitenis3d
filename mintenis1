// Carteles publicitarios con las marcas de Minitenis (Lonvi, Cóndor, Marea, Brasa, Altura)
function createSponsorBanner(text, bgHex, fgHex, w, h) {
  const c = document.createElement('canvas');
  c.width = 512;
  c.height = 128;
  const ctx = c.getContext('2d');
  ctx.fillStyle = bgHex;
  ctx.fillRect(0, 0, 512, 128);
  ctx.strokeStyle = 'rgba(255,255,255,0.25)';
  ctx.lineWidth = 6;
  ctx.strokeRect(6, 6, 500, 116);
  ctx.fillStyle = fgHex;
  ctx.font = '800 44px "Bricolage Grotesque", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(text, 256, 64);
  const tex = new THREE.CanvasTexture(c);
  return new THREE.Mesh(
    new THREE.BoxGeometry(w, h, 0.25),
    new THREE.MeshLambertMaterial({ map: tex })
  );
}

