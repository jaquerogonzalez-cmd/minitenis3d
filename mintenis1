// Configurar posiciones para el saque
function setupPoint() {
  state.phase = 'serve_wait';
  state.rallyCount = 0;
  const totalPts = state.p1.pts + state.p2.pts;
  state.serveSide = (totalPts % 2 === 0) ? 1 : -1;

  state.p1.charging = false;
  state.p1.chargeTime = 0;
  chargeRingMat.opacity = 0;
  aimArrowGroup.visible = false;
  bounceMarker.visible = false;
  document.getElementById('serve-meter').style.display = 'none';

  if (state.server === 1) {
    state.p1.x = state.serveSide * 2.1;
    state.p1.z = HALF_L + 0.4;
    state.p2.x = -state.serveSide * 2.8;
    state.p2.z = -HALF_L - 0.3;
    state.ball.x = state.p1.x + 0.3;
    state.ball.y = 1.1;
    state.ball.z = state.p1.z - 0.2;
  } else {
    state.p2.x = -state.serveSide * 2.1;
    state.p2.z = -HALF_L - 0.4;
    state.p1.x = state.serveSide * 2.8;
    state.p1.z = HALF_L + 0.3;
    state.ball.x = state.p2.x;
    state.ball.y = 1.1;
    state.ball.z = state.p2.z + 0.2;
    setTimeout(() => {
      if (state.running && !state.paused && state.phase === 'serve_wait' && state.server === 2) {
        aiExecuteServe();
      }
    }, 950);
  }
  state.ball.vx = 0; state.ball.vy = 0; state.ball.vz = 0;
}

// Calcular trayectoria física hacia un punto objetivo (tx, tz)
function launchBallTowards(fromX, fromY, fromZ, tx, tz, flightTime, shotType) {
  const gravity = matchCondition === 'altura' ? 16.2 : 18.5;
  state.ball.x = fromX;
  state.ball.y = Math.max(0.45, fromY);
  state.ball.z = fromZ;
  state.ball.vx = (tx - fromX) / flightTime;
  state.ball.vz = (tz - fromZ) / flightTime;
  state.ball.vy = (0.21 - state.ball.y + 0.5 * gravity * flightTime * flightTime) / flightTime;
  state.ball.spin = shotType;
  state.ball.bounces = 0;
  state.ball.targetBounceX = tx;
  state.ball.targetBounceZ = tz;

  bounceMarker.position.set(tx, 0.035, tz);
  bounceMarker.visible = true;
}

// IA realiza el saque
function aiExecuteServe() {
  const leg2 = LEGENDS[selectedP2];
  const targetBoxX = state.serveSide * (0.6 + Math.random() * 1.8);
  const targetBoxZ = 2.6 + Math.random() * (SERVICE_Z - 3.1);
  const flightT = 0.62 - (leg2.stats.serve / 1000);
  state.ball.lastHitter = 2;
  state.phase = 'rally';
  const kmh = Math.round(172 + (leg2.stats.serve - 80) * 1.5 + Math.random() * 14);
  document.getElementById('hud-serve-speed').textContent = `Saque IA: ${kmh} km/h`;
  playSound('hit');
  launchBallTowards(state.p2.x, 2.2, state.p2.z + 0.3, targetBoxX, targetBoxZ, flightT, 'flat');
}

// Jugador 1 lanza o impacta el saque en dos tiempos
function handlePlayerServeButton(shotType) {
  const meter = document.getElementById('serve-meter');
  if (state.phase === 'serve_wait') {
    state.phase = 'serve_toss';
    state.tossHeight = 0.1;
    state.tossVel = 1.65;
    state.p1.queuedShot = shotType;
    meter.style.display = 'block';
    return;
  }
  if (state.phase === 'serve_toss') {
    meter.style.display = 'none';
    const leg1 = LEGENDS[selectedP1];
    // Zona verde está cuando tossHeight está entre 0.62 y 0.88
    const isGreen = state.tossHeight >= 0.58 && state.tossHeight <= 0.90;
    const joy = getInputVector();

    // Si falla mucho el timing en un saque plano, puede ser falta
    const isFault = (!isGreen && shotType === 'flat' && Math.random() < 0.45) || state.tossHeight < 0.25;
    const baseBoxX = -state.serveSide * (1.35 + joy.x * 1.15);
    const targetX = THREE.MathUtils.clamp(baseBoxX, -HALF_W + 0.3, HALF_W - 0.3);
    const targetZ = isFault ? (-SERVICE_Z - 1.3) : (-2.8 - Math.random() * 2.1);

    const speedFactor = isGreen ? 0.54 : 0.68;
    const kmh = Math.round((isGreen ? 196 : 162) + (leg1.stats.serve - 85) * 1.4);
    document.getElementById('hud-serve-speed').textContent = `Saque: ${kmh} km/h`;
    if (!isFault && kmh > state.p1.fastestServe) state.p1.fastestServe = kmh;

    if (isGreen) {
      showFeedback(`¡SAQUE PERFECTO! · ${kmh} km/h`);
      playSound('perfect');
    } else {
      showFeedback('Saque normal');
      playSound('hit');
    }

    state.ball.lastHitter = 1;
    state.phase = 'rally';
    p1Mesh.userData.armPivot.rotation.x = -1.2;
    setTimeout(() => { if (p1Mesh) p1Mesh.userData.armPivot.rotation.x = 0; }, 180);
    launchBallTowards(state.p1.x, 2.35, state.p1.z - 0.2, targetX, targetZ, speedFactor, shotType);
  }
}

// Ejecutar golpe del Jugador 1 durante el peloteo
function tryPlayerHitBall() {
  if (state.phase !== 'rally' || state.ball.lastHitter === 1) return false;
  const dx = state.ball.x - state.p1.x;
  const dz = state.ball.z - state.p1.z;
  const dist = Math.hypot(dx, dz);

  // Alcance máximo del tenista
  if (dist > 2.45 || state.ball.y > 2.85) return false;

  const joy = getInputVector();
  const isMovingFast = Math.hypot(state.p1.vx, state.p1.vz) > 2.5;
  const charge = state.p1.chargeTime;
  const shot = state.p1.queuedShot || 'topspin';

  // Determinar calidad del golpe y motivo si es forzado (según versión 1.5.0 de Minitenis)
  let quality = 'normal';
  let forcedReason = '';

  if (charge > 1.05) {
    quality = 'forced';
    forcedReason = 'Forzado (pasado de carga)';
  } else if (charge < 0.08) {
    quality = 'forced';
    forcedReason = 'Forzado (tarde)';
  } else if (dist < 0.35) {
    quality = 'forced';
    forcedReason = 'Forzado (muy cerca)';
  } else if (dist > 1.95) {
    quality = 'forced';
    forcedReason = 'Forzado (muy lejos)';
  } else if (isMovingFast) {
    quality = 'forced';
    forcedReason = 'Forzado (corriendo)';
  } else if (charge >= 0.22 && charge <= 0.95) {
    quality = 'perfect';
  }

  // Detectar Dejada (Cortado + Joystick arriba) o Smash (pelota alta cerca de la red)
  const isDropShot = (shot === 'slice' && joy.y < -0.35);
  const isSmash = (state.ball.y > 1.65 && state.p1.z < HALF_L - 2.5 && shot !== 'lob');

  let flightTime = 0.78;
  let targetZ = -HALF_L + 2.2 - (-joy.y * 1.6);
  let targetX = joy.x * (HALF_W - 0.65);

  if (isDropShot) {
    flightTime = 0.86;
    targetZ = -1.7 - Math.random() * 1.1;
    showFeedback('¡Dejada corta!');
  } else if (isSmash) {
    flightTime = 0.46;
    targetZ = -HALF_L + 3.2;
    showFeedback('💥 ¡SMASH!');
  } else if (shot === 'flat') {
    flightTime = quality === 'perfect' ? 0.56 : 0.64;
    targetZ = -HALF_L + 1.4;
  } else if (shot === 'topspin') {
    flightTime = quality === 'perfect' ? 0.72 : 0.80;
    targetZ = -HALF_L + 1.8;
  } else if (shot === 'slice') {
    flightTime = 0.90;
    targetZ = -HALF_L + 3.2;
  } else if (shot === 'lob') {
    flightTime = 1.28;
    targetZ = -HALF_L + 1.2;
  }

  // Si sale forzado o con poca energía, hay dispersión
  if (quality === 'forced') {
    targetX += (Math.random() - 0.5) * 2.2;
    if (shot === 'flat' && Math.random() < 0.28) {
      targetZ = -HALF_L - 1.1; // Riesgo de irse larga en golpe plano forzado
    }
    showFeedback(forcedReason, true);
    playSound('forced');
  } else if (quality === 'perfect') {
    if (!isDropShot && !isSmash) showFeedback('✨ ¡GOLPE PERFECTO!');
    playSound('perfect');
  } else {
    playSound('hit');
  }

  state.ball.lastHitter = 1;
  state.rallyCount++;
  if (state.rallyCount > state.p1.longestRally) state.p1.longestRally = state.rallyCount;

  state.p1.charging = false;
  state.p1.chargeTime = 0;
  chargeRingMat.opacity = 0;
  aimArrowGroup.visible = false;

  p1Mesh.userData.armPivot.rotation.x = -1.1;
  setTimeout(() => { if (p1Mesh) p1Mesh.userData.armPivot.rotation.x = 0; }, 160);

  launchBallTowards(state.ball.x, state.ball.y, state.ball.z, targetX, targetZ, flightTime, isSmash ? 'flat' : shot);
  return true;
}

/* ============================================================================
   6. REGLAS DE PUNTUACIÓN (SET A 3 JUEGOS + SÚPER TIE-BREAK EN 3-3)
   ============================================================================ */
function awardPoint(winner) {
  if (state.phase === 'point_pause') return;
  state.phase = 'point_pause';
  bounceMarker.visible = false;
  playSound('crowd');

  if (winner === 1) {
    state.p1.pts++;
    if (state.rallyCount <= 1 && state.server === 1) state.p1.aces++;
    else if (state.ball.lastHitter === 1) state.p1.winners++;
  } else {
    state.p2.pts++;
    if (state.ball.lastHitter === 1) state.p1.errors++;
    else state.p2.winners++;
  }

  const isSuperTieBreak = (state.p1.games === 3 && state.p2.games === 3);
  if (isSuperTieBreak) {
    // Súper tie-break a 10 puntos con diferencia de 2 (propio del Abierto de la Isla)
    if ((state.p1.pts >= 10 || state.p2.pts >= 10) && Math.abs(state.p1.pts - state.p2.pts) >= 2) {
      if (state.p1.pts > state.p2.pts) state.p1.games++;
      else state.p2.games++;
      updateScoreHUD();
      finishMatch();
      return;
    }
    if ((state.p1.pts + state.p2.pts) % 2 === 1) {
      state.server = state.server === 1 ? 2 : 1;
    }
  } else {
    // Juego normal: 0, 15, 30, 40, Iguales
    if ((state.p1.pts >= 4 || state.p2.pts >= 4) && Math.abs(state.p1.pts - state.p2.pts) >= 2) {
      if (state.p1.pts > state.p2.pts) state.p1.games++;
      else state.p2.games++;
      state.p1.pts = 0;
      state.p2.pts = 0;
      state.server = state.server === 1 ? 2 : 1;

      // Gana el set quien llega a 3 juegos (con 2 de ventaja o 4-3 tras el súper tie-break)
      if ((state.p1.games >= 3 || state.p2.games >= 3) && !(state.p1.games === 3 && state.p2.games === 3)) {
        if (state.p1.games >= 3 && state.p1.games - state.p2.games >= 1) {
          updateScoreHUD();
          finishMatch();
          return;
        }
        if (state.p2.games >= 3 && state.p2.games - state.p1.games >= 1) {
          updateScoreHUD();
          finishMatch();
          return;
        }
      }
      if (state.p1.games === 3 && state.p2.games === 3) {
        showFeedback('🔥 ¡3-3! SÚPER TIE-BREAK A 10 PUNTOS');
      }
    }
  }

  state.faults = 0;
  updateScoreHUD();
  setTimeout(() => {
    if (state.running) setupPoint();
  }, 1150);
}

function formatPoints(p1Pts, p2Pts) {
  if (state.p1.games === 3 && state.p2.games === 3) {
    return [String(p1Pts), String(p2Pts)];
  }
  const map = ['0', '15', '30', '40'];
  if (p1Pts >= 3 && p2Pts >= 3) {
    if (p1Pts === p2Pts) return ['40', '40'];
    return p1Pts > p2Pts ? ['AD', '40'] : ['40', 'AD'];
  }
  return [map[Math.min(p1Pts, 3)], map[Math.min(p2Pts, 3)]];
}

function updateScoreHUD() {
  const [s1, s2] = formatPoints(state.p1.pts, state.p2.pts);
  document.getElementById('hud-p1-pts').textContent = s1;
  document.getElementById('hud-p2-pts').textContent = s2;
  document.getElementById('hud-p1-games').textContent = state.p1.games;
  document.getElementById('hud-p2-games').textContent = state.p2.games;
}

function finishMatch() {
  state.running = false;
  document.getElementById('touch-controls').style.display = 'none';
  const won = state.p1.games > state.p2.games;
  document.getElementById('end-title').textContent = won
    ? `🏆 ¡Victoria de ${LEGENDS[selectedP1].name}!`
    : `Fin del partido · Ganó ${LEGENDS[selectedP2].name}`;
  document.getElementById('end-subtitle').textContent =
    `Marcador final: ${state.p1.games} - ${state.p2.games} en el Abierto de la Isla`;
  document.getElementById('stat-p1-head').textContent = LEGENDS[selectedP1].name;
  document.getElementById('stat-p2-head').textContent = LEGENDS[selectedP2].name;

  const rows = [
    [state.p1.games, 'Juegos ganados', state.p2.games],
    [state.p1.aces, 'Aces', state.p2.aces],
    [state.p1.winners, 'Tiros ganadores', state.p2.winners],
    [state.p1.errors, 'Errores no forzados', state.p2.errors],
    [`${state.p1.fastestServe} km/h`, 'Saque más rápido', '184 km/h'],
    [`${state.p1.longestRally} golpes`, 'Peloteo más largo', `${state.p1.longestRally} golpes`]
  ];
  document.getElementById('stats-tbody').innerHTML = rows
    .map(r => `<tr><td><b>${r[0]}</b></td><td>${r[1]}</td><td><b>${r[2]}</b></td></tr>`)
    .join('');
  document.getElementById('end-screen').style.display = 'flex';
}

/* ============================================================================
   7. CONTROLES: TECLADO + JOYSTICK TÁCTIL + 4 BOTONES DE GOLPE
   ============================================================================ */
const keys = {};
const shotKeyMap = { KeyZ: 'topspin', KeyX: 'flat', KeyC: 'slice', KeyV: 'lob' };

window.addEventListener('keydown', e => {
  keys[e.code] = true;
  if (e.code === 'Escape' || e.code === 'Space') {
    if (state.running) togglePause();
  }
  if (e.code === 'KeyF') toggleFullscreen();

  if (state.running && !state.paused && shotKeyMap[e.code]) {
    const shot = shotKeyMap[e.code];
    if (state.server === 1 && (state.phase === 'serve_wait' || state.phase === 'serve_toss')) {
      if (!e.repeat) handlePlayerServeButton(shot);
    } else if (state.phase === 'rally') {
      state.p1.charging = true;
      state.p1.queuedShot = shot;
    }
  }
});

window.addEventListener('keyup', e => {
  keys[e.code] = false;
  if (shotKeyMap[e.code] && state.p1.charging) {
    tryPlayerHitBall();
    state.p1.charging = false;
    state.p1.chargeTime = 0;
    chargeRingMat.opacity = 0;
    aimArrowGroup.visible = false;
  }
});

// Joystick táctil
let joyTouchId = null;
let joyOrigin = { x: 0, y: 0 };
let joyVec = { x: 0, y: 0 };
const joyZone = document.getElementById('joystick-zone');
const joyKnob = document.getElementById('joystick-knob');

joyZone.addEventListener('pointerdown', e => {
  joyTouchId = e.pointerId;
  const rect = document.getElementById('joystick-base').getBoundingClientRect();
  joyOrigin = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
  updateJoyPosition(e.clientX, e.clientY);
});
window.addEventListener('pointermove', e => {
  if (e.pointerId === joyTouchId) updateJoyPosition(e.clientX, e.clientY);
});
window.addEventListener('pointerup', e => {
  if (e.pointerId === joyTouchId) {
    joyTouchId = null;
    joyVec = { x: 0, y: 0 };
    joyKnob.style.transform = 'translate(0px, 0px)';
  }
});

function updateJoyPosition(cx, cy) {
  const dx = cx - joyOrigin.x;
  const dy = cy - joyOrigin.y;
  const maxR = 40;
  const dist = Math.min(Math.hypot(dx, dy), maxR);
  const angle = Math.atan2(dy, dx);
  const kx = Math.cos(angle) * dist;
  const ky = Math.sin(angle) * dist;
  joyKnob.style.transform = `translate(${kx}px, ${ky}px)`;
  joyVec = { x: kx / maxR, y: ky / maxR };
}

function getInputVector() {
  let x = joyVec.x;
  let y = joyVec.y;
  if (keys['ArrowLeft'] || keys['KeyA']) x = -1;
  if (keys['ArrowRight'] || keys['KeyD']) x = 1;
  if (keys['ArrowUp'] || keys['KeyW']) y = -1;
  if (keys['ArrowDown'] || keys['KeyS']) y = 1;
  const len = Math.hypot(x, y);
  if (len > 1) { x /= len; y /= len; }
  return { x, y };
}

// Botones táctiles de golpe
document.querySelectorAll('.shot-btn').forEach(btn => {
  const shot = btn.dataset.shot;
  btn.addEventListener('pointerdown', e => {
    e.preventDefault();
    btn.classList.add('active');
    if (!state.running || state.paused) return;
    if (state.server === 1 && (state.phase === 'serve_wait' || state.phase === 'serve_toss')) {
      handlePlayerServeButton(shot);
    } else if (state.phase === 'rally') {
      state.p1.charging = true;
      state.p1.queuedShot = shot;
    }
  });
  btn.addEventListener('pointerup', () => {
    btn.classList.remove('active');
    if (state.p1.charging) {
      tryPlayerHitBall();
      state.p1.charging = false;
      state.p1.chargeTime = 0;
      chargeRingMat.opacity = 0;
      aimArrowGroup.visible = false;
    }
  });
});

/* ============================================================================
   8. BUCLE PRINCIPAL DE SIMULACIÓN Y RENDERIZADO 3D
   ============================================================================ */
let lastTime = performance.now();

function animate(now) {
  requestAnimationFrame(animate);
  const dt = Math.min((now - lastTime) / 1000, 0.05);
  lastTime = now;

  // Animación de público y banderas de viento
  crowdSpectators.forEach(s => {
    s.position.y = s.userData.baseY + Math.abs(Math.sin(now * 0.004 + s.userData.phase)) * 0.18;
  });
  windFlags.forEach(f => {
    f.mesh.rotation.y = Math.sin(now * 0.008) * (matchCondition === 'viento' ? 0.55 : 0.15);
  });

  if (state.running && !state.paused) {
    updateSimulation(dt);
  }

  renderer.render(scene, camera);
}

function updateSimulation(dt) {
  const leg1 = LEGENDS[selectedP1];
  const leg2 = LEGENDS[selectedP2];

  // 1. Movimiento del Jugador 1
  const inp = getInputVector();
  const energyFactor = state.p1.energy < 25 ? 0.76 : 1.0;
  const maxSpeed1 = (7.4 + (leg1.stats.speed - 85) * 0.12) * energyFactor;

  if (state.phase === 'serve_wait' || state.phase === 'serve_toss') {
    state.p1.vx = 0;
    state.p1.vz = 0;
  } else {
    state.p1.vx = inp.x * maxSpeed1;
    state.p1.vz = inp.y * maxSpeed1;
    state.p1.x = THREE.MathUtils.clamp(state.p1.x + state.p1.vx * dt, -HALF_W - 2.6, HALF_W + 2.6);
    state.p1.z = THREE.MathUtils.clamp(state.p1.z + state.p1.vz * dt, 0.85, HALF_L + 3.6);
    if (Math.hypot(inp.x, inp.y) > 0.2) {
      const drain = matchCondition === 'calor' ? 2.4 : 1.3;
      state.p1.energy = Math.max(10, state.p1.energy - drain * dt);
    }
  }

  // 2. Barra de lanzamiento de saque en 2 tiempos
  if (state.phase === 'serve_toss') {
    state.tossHeight += state.tossVel * dt;
    state.tossVel -= 2.35 * dt;
    state.ball.y = 1.1 + Math.max(0, state.tossHeight * 1.8);
    const cursor = document.getElementById('serve-cursor');
    cursor.style.bottom = `${THREE.MathUtils.clamp(state.tossHeight * 88, 0, 95)}%`;
    if (state.tossHeight <= 0) {
      state.phase = 'serve_wait';
      document.getElementById('serve-meter').style.display = 'none';
      showFeedback('Lanzamiento caído · Intenta de nuevo');
    }
  }

  // 3. Carga del golpe, anillo en el suelo y flecha de puntería
  if (state.p1.charging && state.phase === 'rally') {
    state.p1.chargeTime += dt;
    chargeRing.position.set(state.p1.x, 0.035, state.p1.z);
    chargeRingMat.opacity = 0.88;
    const scale = 0.65 + Math.min(state.p1.chargeTime, 1.1) * 0.55;
    chargeRing.scale.set(scale, scale, 1);
    // Pasa a rojo si se sobrecarga más de 1 segundo (Versión 1.5.0)
    chargeRingMat.color.setHex(state.p1.chargeTime > 1.0 ? 0xff5c5c : 0xd9ec4b);

    aimArrowGroup.visible = true;
    aimArrowGroup.position.set(state.p1.x, 0.04, state.p1.z);
    aimArrowGroup.rotation.y = -inp.x * 0.48;

    // Auto-impacto si la pelota entra en la zona óptima de contacto mientras carga
    const distToBall = Math.hypot(state.ball.x - state.p1.x, state.ball.z - state.p1.z);
    if (state.ball.lastHitter === 2 && distToBall < 1.35 && state.ball.z > state.p1.z - 0.8) {
      tryPlayerHitBall();
    }
  }

  // 4. IA de la Leyenda Rival (Jugador 2)
  if (state.phase === 'rally') {
    const maxSpeed2 = (7.2 + (leg2.stats.speed - 85) * 0.11) * aiDifficulty;
    let desiredX = 0;
    let desiredZ = -HALF_L + 0.5;

    if (state.ball.lastHitter === 1) {
      desiredX = state.ball.targetBounceX;
      desiredZ = THREE.MathUtils.clamp(state.ball.targetBounceZ - 0.6, -HALF_L - 2.2, -1.2);
    } else {
      // Posición de recuperación o subida a la red según el estilo de la Leyenda
      desiredX = state.ball.x * 0.25;
      desiredZ = (Math.random() < leg2.aiNetFreq * 0.02) ? -3.2 : (-HALF_L + 0.4);
    }

    const dx2 = desiredX - state.p2.x;
    const dz2 = desiredZ - state.p2.z;
    const d2 = Math.hypot(dx2, dz2);
    if (d2 > 0.12) {
      state.p2.x += (dx2 / d2) * Math.min(maxSpeed2 * dt, d2);
      state.p2.z += (dz2 / d2) * Math.min(maxSpeed2 * dt, d2);
    }

    // Golpe de respuesta de la IA
    const distBallAI = Math.hypot(state.ball.x - state.p2.x, state.ball.z - state.p2.z);
    if (state.ball.lastHitter === 1 && state.ball.z < 0 && distBallAI < 1.65 && state.ball.y < 2.5) {
      const aimCorner = (state.p1.x > 0 ? -1 : 1) * (1.8 + Math.random() * 2.6);
      const aimDepth = HALF_L - 2.2 - Math.random() * 2.5;
      const aiFlight = 0.72 + Math.random() * 0.16;
      state.ball.lastHitter = 2;
      state.rallyCount++;
      playSound('hit');
      p2Mesh.userData.armPivot.rotation.x = 1.1;
      setTimeout(() => { if (p2Mesh) p2Mesh.userData.armPivot.rotation.x = 0; }, 160);
      launchBallTowards(state.ball.x, state.ball.y, state.ball.z, aimCorner, aimDepth, aiFlight, 'topspin');
    }
  }

  // 5. Física de la pelota en vuelo, viento, red y botes
  if (state.phase === 'rally') {
    const gravity = matchCondition === 'altura' ? 16.2 : 18.5;
    const prevZ = state.ball.z;

    if (matchCondition === 'viento') {
      state.ball.vx += 1.35 * dt;
    }

    state.ball.x += state.ball.vx * dt;
    state.ball.y += state.ball.vy * dt;
    state.ball.z += state.ball.vz * dt;
    state.ball.vy -= gravity * dt;

    // Colisión con la red central (z = 0)
    if ((prevZ > 0 && state.ball.z <= 0) || (prevZ < 0 && state.ball.z >= 0)) {
      if (state.ball.y < 0.96) {
        // Toca la cinta o queda en la red
        if (state.ball.y > 0.84 && state.rallyCount === 0) {
          // Let de saque: toca la cinta y pasa
          showFeedback('¡LET! · Se repite el saque');
          setupPoint();
          return;
        }
        showFeedback('¡A la red!', true);
        handleOutOrNet();
        return;
      }
    }

    // Pique / Bote en el suelo
    if (state.ball.y <= 0.21) {
      state.ball.y = 0.21;
      state.ball.bounces++;
      playSound('bounce');

      if (state.ball.bounces === 1) {
        // Verificar si picó dentro de los límites reglamentarios
        const isServeShot = (state.rallyCount === 0);
        let inBounds = Math.abs(state.ball.x) <= HALF_W + 0.18 && Math.abs(state.ball.z) <= HALF_L + 0.18;

        if (isServeShot) {
          const validZ = state.server === 1
            ? (state.ball.z <= 0 && state.ball.z >= -SERVICE_Z - 0.22)
            : (state.ball.z >= 0 && state.ball.z <= SERVICE_Z + 0.22);
          inBounds = inBounds && validZ;
        }

        if (!inBounds) {
          handleOutOrNet();
          return;
        }

        // Bote realista según el efecto (Versión 1.0.1 de Minitenis)
        if (state.ball.spin === 'slice') {
          state.ball.vy = Math.abs(state.ball.vy) * 0.48;
          state.ball.vz *= 0.72;
        } else if (state.ball.spin === 'topspin') {
          state.ball.vy = Math.min(Math.abs(state.ball.vy) * 0.74, 6.8);
          state.ball.vz *= 0.88;
        } else if (state.ball.spin === 'lob') {
          state.ball.vy = Math.min(Math.abs(state.ball.vy) * 0.78, 8.2);
          state.ball.vz *= 0.75;
        } else {
          state.ball.vy = Math.min(Math.abs(state.ball.vy) * 0.64, 5.8);
          state.ball.vz *= 0.86;
        }
      } else if (state.ball.bounces >= 2) {
        // Doble bote: punto para quien golpeó la pelota
        awardPoint(state.ball.lastHitter);
        return;
      }
    }

    // Si la pelota se aleja mucho del estadio sin segundo bote
    if (Math.abs(state.ball.z) > HALF_L + 7.5 || Math.abs(state.ball.x) > HALF_W + 6.5) {
      if (state.ball.bounces === 0) {
        handleOutOrNet();
      } else {
        awardPoint(state.ball.lastHitter);
      }
      return;
    }
  }

  // Actualizar mallas 3D
  if (p1Mesh) p1Mesh.position.set(state.p1.x, 0, state.p1.z);
  if (p2Mesh) p2Mesh.position.set(state.p2.x, 0, state.p2.z);
  ballMesh.position.set(state.ball.x, state.ball.y, state.ball.z);
  ballShadow.position.set(state.ball.x, 0.025, state.ball.z);
}

function handleOutOrNet() {
  if (state.rallyCount === 0) {
    // Falta de saque
    state.faults++;
    if (state.faults === 1) {
      showFeedback('¡Falta! · Segundo saque', true);
      setTimeout(() => { if (state.running) setupPoint(); }, 900);
    } else {
      showFeedback('¡DOBLE FALTA!', true);
      state.faults = 0;
      awardPoint(state.server === 1 ? 2 : 1);
    }
  } else {
    showFeedback('¡FUERA!', true);
    awardPoint(state.ball.lastHitter === 1 ? 2 : 1);
  }
}

/* ============================================================================
   9. INTERFAZ DEL MENÚ, PANTALLA COMPLETA Y BOTÓN DE DESCARGA DIRECTA
   ============================================================================ */
function renderMenuUI() {
  const container = document.getElementById('legends-container');
  container.innerHTML = LEGENDS.map((leg, idx) => `
    <div class="legend-card ${idx === selectedP1 ? 'selected-p1' : ''}" data-idx="${idx}">
      <div class="legend-top">
        <span class="legend-name">${leg.name}</span>
        <span class="tier-tag">★ LEYENDA</span>
      </div>
      <div class="gear-info">${leg.style}<br><b>${leg.kit}</b></div>
      <div class="stat-bar-row"><span>Velocidad</span><div class="stat-track"><div class="stat-fill" style="width:${leg.stats.speed}%"></div></div></div>
      <div class="stat-bar-row"><span>Potencia</span><div class="stat-track"><div class="stat-fill" style="width:${leg.stats.power}%"></div></div></div>
      <div class="stat-bar-row"><span>Control</span><div class="stat-track"><div class="stat-fill" style="width:${leg.stats.control}%"></div></div></div>
      <div class="stat-bar-row"><span>Saque</span><div class="stat-track"><div class="stat-fill" style="width:${leg.stats.serve}%"></div></div></div>
    </div>
  `).join('');

  container.querySelectorAll('.legend-card').forEach(card => {
    card.addEventListener('click', () => {
      selectedP1 = Number(card.dataset.idx);
      if (selectedP2 === selectedP1) selectedP2 = (selectedP1 + 1) % LEGENDS.length;
      renderMenuUI();
    });
  });

  const rivalRow = document.getElementById('rival-row');
  rivalRow.innerHTML = LEGENDS.map((leg, idx) => `
    <button class="chip-btn ${idx === selectedP2 ? 'active' : ''}" data-ridx="${idx}">
      Rival: ${leg.name}
    </button>
  `).join('');

  rivalRow.querySelectorAll('.chip-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedP2 = Number(btn.dataset.ridx);
      renderMenuUI();
    });
  });
}

document.querySelectorAll('#diff-row .chip-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#diff-row .chip-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    aiDifficulty = parseFloat(btn.dataset.diff);
  });
});

document.querySelectorAll('#cond-row .chip-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#cond-row .chip-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    matchCondition = btn.dataset.cond;
  });
});

function startNewMatch() {
  document.getElementById('menu-screen').style.display = 'none';
  document.getElementById('end-screen').style.display = 'none';
  document.getElementById('touch-controls').style.display = 'block';

  // Aplicar iluminación según condición (Día o Noche)
  if (matchCondition === 'noche') {
    scene.background = new THREE.Color(0x0b132b);
    ambientLight.intensity = 0.55;
    dirLight.intensity = 1.15;
  } else {
    scene.background = new THREE.Color(0x87ceeb);
    ambientLight.intensity = 0.75;
    dirLight.intensity = 0.9;
  }

  // Crear modelos 3D de las Leyendas seleccionadas
  if (p1Mesh) scene.remove(p1Mesh);
  if (p2Mesh) scene.remove(p2Mesh);
  p1Mesh = createTennisPlayerMesh(LEGENDS[selectedP1]);
  p2Mesh = createTennisPlayerMesh(LEGENDS[selectedP2]);
  p2Mesh.rotation.y = Math.PI;
  scene.add(p1Mesh);
  scene.add(p2Mesh);

  document.getElementById('hud-p1-name').textContent = LEGENDS[selectedP1].name;
  document.getElementById('hud-p2-name').textContent = LEGENDS[selectedP2].name;

  state.p1.pts = 0; state.p1.games = 0; state.p1.energy = 100;
  state.p1.aces = 0; state.p1.winners = 0; state.p1.errors = 0;
  state.p1.fastestServe = 0; state.p1.longestRally = 0;
  state.p2.pts = 0; state.p2.games = 0; state.p2.aces = 0; state.p2.winners = 0; state.p2.errors = 0;
  state.server = 1;
  state.faults = 0;
  state.running = true;
  state.paused = false;

  updateScoreHUD();
  setupPoint();
}

document.getElementById('btn-start-match').addEventListener('click', startNewMatch);
document.getElementById('btn-rematch').addEventListener('click', startNewMatch);
document.getElementById('btn-back-menu').addEventListener('click', () => {
  document.getElementById('end-screen').style.display = 'none';
  document.getElementById('menu-screen').style.display = 'flex';
});

function togglePause() {
  state.paused = !state.paused;
  document.getElementById('btn-pause').textContent = state.paused ? '▶ Seguir' : '⏸ Pausa';
  showFeedback(state.paused ? 'Partido en Pausa' : '¡Juego reanudado!');
}
document.getElementById('btn-pause').addEventListener('click', () => {
  if (state.running) togglePause();
});

function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen?.();
  } else {
    document.exitFullscreen?.();
  }
}
document.getElementById('btn-fullscreen').addEventListener('click', toggleFullscreen);

// Descargar este mismo archivo HTML completo para jugarlo localmente
function downloadStandaloneHTML() {
  const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'minitenis-3d-leyendas.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
document.getElementById('btn-download').addEventListener('click', downloadStandaloneHTML);
document.getElementById('btn-download-menu').addEventListener('click', downloadStandaloneHTML);

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

renderMenuUI();
requestAnimationFrame(animate);
</script>
