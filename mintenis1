// Mostrar mensajes de feedback en pantalla
let feedbackTimeout = null;
function showFeedback(text, isForced = false) {
  const banner = document.getElementById('feedback-banner');
  const pill = document.getElementById('feedback-text');
  pill.textContent = text;
  pill.className = isForced ? 'pill-msg forced' : 'pill-msg';
